# Local-only Google Sheet link — keep the source sheet private, never on GitHub.
.sheet-url

# Local-only service account key for editing the Google Sheet — never on GitHub.
.sheet-credentials.json

# Python noise
__pycache__/
*.pyc

# Dépendances Node (outils de vérification headless) — jamais versionnées
node_modules/

# APK : distribuée par GitHub Releases, jamais par le dépôt
*.apk

# Captures de vérification headless (scratch local)
/screenshot*.png
/out*.png

# Firebase CLI / Emulator local logs and cache
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log

# fichier local chiffré — ne jamais publier
photos/gal.enc

# Lien local du dossier Drive photos partagées — jamais sur GitHub
.drive-folder
